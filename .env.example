# 複製成 .env.local 後填值（.env.local 不可 commit）。說明見 docs/10_A0後架構調整.md 第 2 節。

# ── 前端（Vite 只會把 VITE_ 開頭的給瀏覽器）──
VITE_API_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 後端（只在 server/ 與 scripts/ 讀）──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# 模型（2026-10-30 實測後的團隊統一設定，三人填一樣的；理由見 docs/DEVLOG.md「模型選定」）
MODEL_CHAT=gemini-2.5-flash-nothinking      # 阿澈、分身：快（約 4 秒），中文自然
MODEL_REASON=gemini-2.5-flash-nothinking    # 任務解析、挑人、評審：JSON 4/4、約 3 秒；不要用 thinking／reasoner／pro 這類慢模型
MODEL_FAST=qwen-flash                       # 隱私守門、記憶擷取：會擋地址（gpt-4.1-nano 擋不住，不要用）
MODEL_EMBED=text-embedding-3-small          # 不要改：雲端種子用戶的向量是用它算的，換了要重跑 seed
EMBEDDING_DIM=1024
