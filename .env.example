# 複製成 .env.local 後填值（.env.local 不可 commit）。說明見 docs/10_A0後架構調整.md 第 2 節。

# ── 前端（Vite 只會把 VITE_ 開頭的給瀏覽器）──
VITE_API_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 後端（只在 server/ 與 scripts/ 讀）──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_BASE_URL=
LLM_API_KEY=
MODEL_CHAT=
MODEL_REASON=
MODEL_FAST=
MODEL_EMBED=
EMBEDDING_DIM=1024
