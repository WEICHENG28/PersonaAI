# 複製成 .env.local 後填值（.env.local 不可 commit）。說明見 docs/10_A0後架構調整.md 第 2 節。

# ── 前端（Vite 只會把 VITE_ 開頭的給瀏覽器）──
VITE_API_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 後端（只在 server/ 與 scripts/ 讀）──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# 學校平台暫定設定（P0-1 探測結果，待 E-3 定案）；切換前先重算既有向量。
MODEL_CHAT=Kimi-K2.6
MODEL_REASON=Qwen3.8-Max
MODEL_FAST=Qwen3.8-Flash
MODEL_EMBED=GLM-Embedding-3
EMBEDDING_DIM=1024
LLM_MODEL_PARAMS={"Qwen3.8-Max":{"thinking":{"type":"disabled"}},"Qwen3.8-Flash":{"thinking":{"type":"disabled"}}}
# 管理員完整 health 檢查；填入至少 16 字元的隨機值。
ADMIN_SECRET=
